# Copy this file to .env and fill in real values locally.
# Never commit .env — it's already git-ignored (see .gitignore's *.env pattern).

# Postgres connection string used by src/db/index.ts and drizzle-kit.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# UploadThing token used by src/app/api/uploadthing (avatar/banner uploads).
# Get this from your UploadThing dashboard project settings.
UPLOADTHING_TOKEN=
